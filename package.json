{
  "name": "heyo-ui-monorepo",
  "private": true,
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "bun run --filter heyo-ui-playground dev",
    "build": "bun run --filter @heyo-sh/heyo-ui build",
    "typecheck": "bun run --filter @heyo-sh/heyo-ui build && bun run --filter @heyo-sh/heyo-ui typecheck && bun run --filter heyo-ui-playground typecheck",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "verify": "bun run --filter @heyo-sh/heyo-ui verify:install",
    "smoke": "bun run --filter heyo-ui-playground smoke",
    "format-staged": "lint-staged",
    "prepare": "husky",
    "quality:pre-push": "bun run lint && bun run typecheck && bun run smoke",
    "quality": "bun run lint && bun run typecheck && bun run build && bun run verify && bun run smoke",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-types": "1.4.2",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{cjs,css,cts,html,js,json,jsonc,jsx,md,mdx,mjs,mts,ts,tsx,yaml,yml}": "prettier --write"
  }
}
